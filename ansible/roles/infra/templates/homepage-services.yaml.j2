# Generated by Ansible from network.yml. Do not edit manually.
# Source: ansible/roles/infra/templates/homepage-services.yaml.j2
#
# One group per VM. Links point at <host>.home; custom.js rewrites them to
# <host>.wsh when the dashboard is opened over the tailnet. Site monitors and
# widgets talk to backends directly (bypassing Traefik and Authentik).
{% set ns = namespace(groups=[]) %}
{% for svc in all_location_services %}
{%   if svc.traefik | default(true) and svc.name not in homepage_exclude and svc.vm not in ns.groups %}
{%     set ns.groups = ns.groups + [svc.vm] %}
{%   endif %}
{% endfor %}
{% for group in ns.groups %}
- {{ group }}:
{%   for svc in all_location_services
       if svc.vm == group and svc.traefik | default(true) and svc.name not in homepage_exclude %}
{%     set h = svc.hostname | default(svc.name) %}
{%     if svc.vm_ip == traefik_ip %}
{%       set internal = 'http://' ~ homepage_container_names.get(svc.name, svc.name) ~ ':' ~ svc.port %}
{%     else %}
{%       set internal = 'http://' ~ svc.vm_ip ~ ':' ~ (svc.host_port | default(svc.port)) %}
{%     endif %}
{%     if svc.public_hostname is defined %}
{%       set href = 'https://' ~ svc.public_hostname %}
{%       set monitor = href %}
{%     else %}
{%       set href = 'https://' ~ h ~ '.home' %}
{%       set monitor = internal %}
{%     endif %}
{%     set w = homepage_widgets.get(svc.name) %}
    - {{ homepage_display_names.get(svc.name, svc.name | replace('-', ' ') | title) | to_json }}:
        icon: {{ homepage_icons.get(svc.name, svc.name ~ '.png') | to_json }}
        href: {{ href | to_json }}
        siteMonitor: {{ monitor | to_json }}
{%     if w and w.secret in homepage_secrets %}
        widget:
          type: {{ w.type }}
          url: {{ internal | to_json }}
          key: "{{ '{{' }}HOMEPAGE_VAR_{{ w.secret }}{{ '}}' }}"
{%       for k, v in (w.options | default({})).items() %}
          {{ k }}: {{ v | to_json }}
{%       endfor %}
{%     endif %}
{%   endfor %}
{% endfor %}
